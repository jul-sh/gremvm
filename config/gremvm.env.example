# This file is copied to ~/Library/Application Support/GremVM/config/gremvm.env.
# Shell quoting is supported; keep this file readable only by the owning user.
GREMVM_VM_NAME=work
GREMVM_CPU_COUNT=4
GREMVM_MEMORY=8GB
GREMVM_DISK_SIZE=150GB
GREMVM_DISPLAY=1920x1200
# "latest" is accepted only on macOS 26. On newer hosts, use an absolute path
# to a reviewed macOS 26 (Tahoe) IPSW; other guest major versions are rejected.
GREMVM_IPSW=latest
GREMVM_GUEST_ADMIN_USER=lume
GREMVM_SHUTDOWN_TIMEOUT=75
GREMVM_SHUTDOWN_SETTLE_SECONDS=20
GREMVM_REQUIRE_APPLICATION_FIREWALL=true
