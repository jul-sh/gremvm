# This file is copied to ~/Library/Application Support/GremVM/config/gremvm.env.
# Shell quoting is supported; keep it readable only by the owning user.
GREMVM_VM_NAME=work
GREMVM_CPU_COUNT=4
GREMVM_MEMORY_MB=8192
GREMVM_DISK_SIZE_GB=150
GREMVM_DISPLAY=1920x1200

# "latest" asks Apple's Virtualization.framework for the latest restore image
# supported by this host. An absolute local .ipsw path is also accepted.
GREMVM_IPSW=latest

# Create this exact short account name during the one-time guest Setup Assistant.
GREMVM_GUEST_ADMIN_USER=grem
GREMVM_SHUTDOWN_TIMEOUT=90
