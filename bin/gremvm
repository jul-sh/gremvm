#!/bin/sh

set -eu
umask 077

PROGRAM=${0##*/}
LABEL=io.gremvm.lume
HOST_HOME=$HOME
ROOT=$HOST_HOME/Library/Application\ Support/GremVM
VM_NAME=work
VM_STORAGE=$ROOT/vms
LUME_BIN=$ROOT/runtime/current/lume.app/Contents/MacOS/lume
LAUNCH_AGENT=$HOST_HOME/Library/LaunchAgents/$LABEL.plist
LOG_DIR=$ROOT/logs
STATE_DIR=$ROOT/state
GUEST_POLL_SECONDS=20
GUEST_STARTUP_POLLS=30
GUEST_FAILURE_POLLS=45
RUNNER_STOP_POLLS=10
RUNNER_PID=

SCRIPT_PATH=$0
case $SCRIPT_PATH in
    */*) ;;
    *) SCRIPT_PATH=$(command -v "$SCRIPT_PATH") || exit 1 ;;
esac
symlink_hops=0
while [ -L "$SCRIPT_PATH" ]; do
    symlink_hops=$((symlink_hops + 1))
    [ "$symlink_hops" -le 20 ] || {
        printf '%s: too many executable symlinks\n' "$PROGRAM" >&2
        exit 1
    }
    link_target=$(/usr/bin/readlink "$SCRIPT_PATH") || exit 1
    case $link_target in
        /*) SCRIPT_PATH=$link_target ;;
        *) SCRIPT_PATH=$(dirname -- "$SCRIPT_PATH")/$link_target ;;
    esac
done
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
REPO_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd -P)
VERSIONS_FILE=$REPO_ROOT/versions/lume.env
readonly PROGRAM LABEL HOST_HOME ROOT VM_NAME VM_STORAGE LUME_BIN LAUNCH_AGENT LOG_DIR STATE_DIR GUEST_POLL_SECONDS GUEST_STARTUP_POLLS GUEST_FAILURE_POLLS RUNNER_STOP_POLLS SCRIPT_DIR REPO_ROOT VERSIONS_FILE

die() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

note() {
    printf '%s\n' "$*"
}

require_command() {
    command -v "$1" > /dev/null 2>&1 || die "required command not found: $1"
}

load_release() {
    [ -r "$VERSIONS_FILE" ] || die "missing release pin: $VERSIONS_FILE"
    # The release file is repository-controlled and contains assignments only.
    # shellcheck disable=SC1090
    . "$VERSIONS_FILE"
}

validate_deployment() {
    [ ! -L "$VM_STORAGE/$VM_NAME" ] || die "VM directory may not be a symbolic link"
}

lume() {
    [ -x "$LUME_BIN" ] || die "Lume is not installed; run '$PROGRAM install'"
    "$LUME_BIN" "$@"
}

service_target() {
    printf 'gui/%s/%s\n' "$(id -u)" "$LABEL"
}

service_loaded() {
    launchctl print "$(service_target)" > /dev/null 2>&1
}

vm_exists() {
    lume get "$VM_NAME" --storage "$VM_STORAGE" --format json > /dev/null 2>&1
}

vm_field() {
    field=$1
    lume get "$VM_NAME" --storage "$VM_STORAGE" --format json 2> /dev/null |
        /usr/bin/plutil -extract "0.$field" raw -o - - 2> /dev/null
}

xml_escape() {
    /usr/bin/sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' -e "s/'/\&apos;/g"
}

verify_lume_bundle() {
    release_dir=$1
    [ -d "$release_dir/lume.app" ] || return 1
    signed_lume=$release_dir/lume.app/Contents/MacOS/lume
    [ -x "$signed_lume" ] || return 1
    /usr/bin/codesign --verify --deep --strict "$release_dir/lume.app" > /dev/null 2>&1 || return 1
    /usr/sbin/spctl --assess --type execute "$release_dir/lume.app" > /dev/null 2>&1 || return 1
    signature=$(/usr/bin/codesign -dv --verbose=4 "$release_dir/lume.app" 2>&1) || return 1
    team=$(printf '%s\n' "$signature" | /usr/bin/awk -F= '$1 == "TeamIdentifier" { print $2 }')
    identifier=$(printf '%s\n' "$signature" | /usr/bin/awk -F= '$1 == "Identifier" { print $2 }')
    [ "$team" = "$LUME_TEAM_ID" ] || return 1
    [ "$identifier" = "$LUME_BUNDLE_ID" ] || return 1
    printf '%s\n' "$signature" | /usr/bin/grep -Eq '^CodeDirectory .*flags=.*\(runtime\)' || return 1
    reported=$("$signed_lume" --version 2> /dev/null) || return 1
    [ "$reported" = "$LUME_VERSION" ]
}

prepare_lume_release() (
    runtime_dir=$ROOT/runtime
    release_dir=$runtime_dir/lume-$LUME_VERSION
    mkdir -p "$runtime_dir"
    chmod 700 "$runtime_dir"

    if [ -e "$release_dir" ]; then
        verify_lume_bundle "$release_dir" || die "existing Lume runtime failed verification: $release_dir"
    else
        require_command curl
        require_command shasum
        staging=$(mktemp -d "$runtime_dir/.install.XXXXXX")
        archive=$staging/lume.tar.gz
        # shellcheck disable=SC2329 # Called asynchronously by the EXIT trap below.
        cleanup_install() {
            /bin/rm -R "$staging"
        }
        trap cleanup_install EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM

        note "Downloading pinned Lume $LUME_VERSION..."
        curl -fL --retry 3 --proto '=https' --tlsv1.2 -o "$archive" "$LUME_ARCHIVE_URL"
        actual=$(/usr/bin/shasum -a 256 "$archive" | /usr/bin/awk '{print $1}')
        [ "$actual" = "$LUME_ARCHIVE_SHA256" ] || die "Lume archive checksum mismatch"

        mkdir "$staging/unpack"
        /usr/bin/tar -xzf "$archive" -C "$staging/unpack"
        verify_lume_bundle "$staging/unpack" || die "Lume signature, hardened runtime, Gatekeeper, identity, or version verification failed"
        /bin/mv "$staging/unpack" "$release_dir"
        trap - EXIT HUP INT TERM
        /bin/rm -R "$staging"
    fi
)

activate_lume_release() {
    runtime_dir=$ROOT/runtime
    release_dir=$runtime_dir/lume-$LUME_VERSION
    verify_lume_bundle "$release_dir" || die "prepared Lume runtime failed verification: $release_dir"
    if [ -e "$runtime_dir/current" ] && [ ! -L "$runtime_dir/current" ]; then
        die "refusing to replace non-symlink Lume activation path: $runtime_dir/current"
    fi
    next_link=$runtime_dir/.current.$$
    /bin/ln -s "lume-$LUME_VERSION" "$next_link"
    /bin/mv -f -h "$next_link" "$runtime_dir/current"
    [ -L "$runtime_dir/current" ] || die "Lume activation path is not a symbolic link"
    verify_lume_bundle "$runtime_dir/current" || die "activated Lume runtime failed verification"
}

prepare_runtime_paths() {
    mkdir -p "$VM_STORAGE" "$LOG_DIR" "$STATE_DIR"
    chmod 700 "$ROOT" "$VM_STORAGE" "$LOG_DIR" "$STATE_DIR"
}

write_launch_agent() {
    mkdir -p "$HOME/Library/LaunchAgents" "$LOG_DIR"
    chmod 700 "$LOG_DIR"
    /usr/bin/touch "$LOG_DIR/vm.log" "$LOG_DIR/vm.error.log"
    chmod 600 "$LOG_DIR/vm.log" "$LOG_DIR/vm.error.log"

    plist_tmp=$HOME/Library/LaunchAgents/.$LABEL.$$.plist
    cli_xml=$(printf '%s' "$ROOT/bin/gremvm" | xml_escape)
    home_xml=$(printf '%s' "$HOME" | xml_escape)
    ready_xml=$(printf '%s' "$STATE_DIR/READY" | xml_escape)
    /usr/bin/plutil -create xml1 "$plist_tmp"
    /usr/bin/plutil -insert Label -string "$LABEL" "$plist_tmp"
    /usr/bin/plutil -insert ProgramArguments -xml "<array><string>$cli_xml</string><string>internal-supervise</string></array>" "$plist_tmp"
    /usr/bin/plutil -insert KeepAlive -xml "<dict><key>PathState</key><dict><key>$ready_xml</key><true/></dict></dict>" "$plist_tmp"
    /usr/bin/plutil -insert ThrottleInterval -integer 20 "$plist_tmp"
    /usr/bin/plutil -insert LimitLoadToSessionType -string Aqua "$plist_tmp"
    /usr/bin/plutil -insert StandardOutPath -string "$LOG_DIR/vm.log" "$plist_tmp"
    /usr/bin/plutil -insert StandardErrorPath -string "$LOG_DIR/vm.error.log" "$plist_tmp"
    /usr/bin/plutil -insert EnvironmentVariables -xml "<dict><key>HOME</key><string>$home_xml</string></dict>" "$plist_tmp"
    /usr/bin/plutil -lint "$plist_tmp" > /dev/null
    chmod 644 "$plist_tmp"
    /bin/mv "$plist_tmp" "$LAUNCH_AGENT"
}

firewall_ok() {
    load_release
    firewall=/usr/libexec/ApplicationFirewall/socketfilterfw
    [ -x "$firewall" ] || return 1
    global=$($firewall --getglobalstate 2> /dev/null || true)
    case $global in
        *'State = 1'*) ;;
        *) return 1 ;;
    esac
    app=$ROOT/runtime/lume-$LUME_VERSION/lume.app
    blocked=$($firewall --getappblocked "$app" 2> /dev/null || true)
    case $blocked in
        *' is blocked.'*) return 0 ;;
        *) return 1 ;;
    esac
}

configure_firewall() {
    firewall=/usr/libexec/ApplicationFirewall/socketfilterfw
    [ -x "$firewall" ] || die "macOS Application Firewall control tool is unavailable"
    global=$($firewall --getglobalstate 2> /dev/null || true)
    case $global in
        *'State = 1'*) ;;
        *) die "macOS Application Firewall is disabled. Enable it, then rerun install." ;;
    esac
    app=$ROOT/runtime/lume-$LUME_VERSION/lume.app
    note "Adding a deny-inbound Application Firewall rule for Lume (administrator approval may be requested)..."
    sudo "$firewall" --add "$app" > /dev/null 2>&1 || true
    sudo "$firewall" --blockapp "$app" > /dev/null
    firewall_ok || die "the deny-inbound Lume firewall rule could not be verified"
}

write_provision_state() {
    next_state=$1
    case $next_state in
        creating | created | sip-disabled | ready) ;;
        *) die "invalid provision state: $next_state" ;;
    esac
    state_tmp=$STATE_DIR/.provision-state.$$
    printf '%s\n' "$next_state" > "$state_tmp"
    /bin/mv "$state_tmp" "$STATE_DIR/provision-state"
    if [ "$next_state" = ready ]; then
        /usr/bin/touch "$STATE_DIR/READY"
        chmod 600 "$STATE_DIR/READY"
    else
        /bin/rm -f "$STATE_DIR/READY"
    fi
}

provision_state() {
    state_file=$STATE_DIR/provision-state
    if [ -e "$state_file" ]; then
        [ -r "$state_file" ] || die "provision state is unreadable: $state_file"
        recorded_state=$(/bin/cat "$state_file")
        case $recorded_state in
            creating) printf '%s\n' creating ;;
            created | sip-disabled | ready)
                if vm_exists; then
                    printf '%s\n' "$recorded_state"
                else
                    printf '%s\n' managed-vm-missing
                fi
                ;;
            *) die "unknown provision state in $state_file: $recorded_state" ;;
        esac
    elif vm_exists; then
        printf '%s\n' foreign-vm
    else
        printf '%s\n' absent
    fi
}

install_command() {
    [ "$(uname -s)" = Darwin ] || die "the host must be macOS"
    [ "$(uname -m)" = arm64 ] || die "Lume requires an Apple-silicon Mac"
    load_release
    prepare_runtime_paths

    if service_loaded; then
        stop_command
    fi

    prepare_lume_release
    configure_firewall
    mkdir -p "$ROOT/bin" "$ROOT/versions"
    chmod 700 "$ROOT/bin" "$ROOT/versions"
    cli_tmp=$ROOT/bin/.gremvm.$$
    /usr/bin/install -m 755 "$REPO_ROOT/bin/gremvm" "$cli_tmp"
    /bin/mv "$cli_tmp" "$ROOT/bin/gremvm"
    /usr/bin/install -m 600 "$VERSIONS_FILE" "$ROOT/versions/lume.env"
    activate_lume_release
    write_launch_agent

    if [ "$(provision_state)" = ready ]; then
        start_command
    else
        note "Installed GremVM. Next: $ROOT/bin/gremvm provision"
    fi
}

provision_command() {
    load_release
    validate_deployment
    [ -x "$LUME_BIN" ] || die "run '$PROGRAM install' first"
    firewall_ok || die "Lume's inbound firewall block is missing; rerun '$PROGRAM install'"
    require_command vncdo

    while :; do
        state=$(provision_state)
        case $state in
            absent)
                write_provision_state creating
                ;;
            creating)
                if vm_exists; then
                    for required in disk.img nvram.bin config.json; do
                        [ -f "$VM_STORAGE/$VM_NAME/$required" ] ||
                            die "Lume creation was interrupted before $required existed; partial VM data was preserved for inspection"
                    done
                else
                    note "Creating the fixed Tahoe VM with Lume's built-in unattended preset..."
                    lume create "$VM_NAME" --ipsw latest --unattended tahoe --storage "$VM_STORAGE"
                fi
                write_provision_state created
                ;;
            created)
                note "Disabling SIP through the VM's paired Recovery environment..."
                lume sip off "$VM_NAME" --yes --storage "$VM_STORAGE"
                write_provision_state sip-disabled
                ;;
            sip-disabled)
                write_provision_state ready
                ;;
            ready)
                start_command
                note "Provisioned '$VM_NAME' with SIP disabled."
                return 0
                ;;
            foreign-vm)
                die "VM '$VM_NAME' exists without GremVM provision state; preserving it and refusing automatic adoption"
                ;;
            managed-vm-missing)
                /bin/rm -f "$STATE_DIR/READY"
                die "GremVM provision state exists but VM '$VM_NAME' is missing; refusing to recreate it implicitly"
                ;;
            *) die "unhandled provision state: $state" ;;
        esac
    done
}

start_command() {
    load_release
    validate_deployment
    [ -r "$LAUNCH_AGENT" ] || die "not installed; run '$PROGRAM install'"
    [ "$(provision_state)" = ready ] || die "VM '$VM_NAME' is not ready"
    firewall_ok || die "Lume's inbound firewall block is missing; rerun '$PROGRAM install'"
    if service_loaded; then
        note "VM service is already running."
        return 0
    fi
    launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT"
    note "VM service started."
}

stop_command() {
    validate_deployment
    if service_loaded; then
        launchctl bootout --wait "$(service_target)"
    fi
    if [ -x "$LUME_BIN" ] && vm_exists && [ "$(vm_field status 2> /dev/null || true)" = running ]; then
        note "Stopping the VM with Lume..."
        lume stop "$VM_NAME" --storage "$VM_STORAGE"
    fi
    note "VM service stopped."
}

restart_command() {
    stop_command
    start_command
}

status_command() {
    load_release
    validate_deployment
    if [ ! -x "$LUME_BIN" ]; then
        note "state: not-installed"
        return 0
    fi
    deployment_state=$(provision_state)
    case $deployment_state in
        absent) state=not-provisioned ;;
        foreign-vm) state=unmanaged-vm ;;
        creating | created | sip-disabled) state=provisioning-$deployment_state ;;
        managed-vm-missing) state=degraded-missing-vm ;;
        ready)
            vm_status=$(vm_field status 2> /dev/null || printf unknown)
            if service_loaded; then
                case $vm_status in
                    running)
                        if [ "$(vm_field sshAvailable 2> /dev/null || true)" = true ]; then
                            state=running
                        else
                            state=guest-unavailable
                        fi
                        ;;
                    stopped) state=starting ;;
                    *) state=degraded ;;
                esac
            else
                case $vm_status in
                    running) state=unmanaged-running ;;
                    stopped) state=stopped ;;
                    *) state=degraded ;;
                esac
            fi
            ;;
        *) die "unhandled provision state: $deployment_state" ;;
    esac
    note "state: $state"
    note "lume: $LUME_VERSION"
    if [ "$deployment_state" = ready ]; then
        note "sip: disabled"
        if firewall_ok; then
            note "firewall: enabled-and-lume-blocked"
        else
            note "firewall: unsafe-or-unverified"
        fi
    fi
}

logs_command() {
    [ "$#" -eq 0 ] || die "usage: $PROGRAM logs"
    [ -e "$LOG_DIR/vm.log" ] || die "no logs yet; run '$PROGRAM install'"
    /usr/bin/tail -n 200 "$LOG_DIR/vm.log" "$LOG_DIR/vm.error.log"
}

uninstall_command() {
    validate_deployment
    if service_loaded || { [ -x "$LUME_BIN" ] && vm_exists; }; then
        stop_command
    fi
    [ ! -e "$LAUNCH_AGENT" ] || /bin/rm -f "$LAUNCH_AGENT"
    for removal in "$ROOT/runtime" "$ROOT/bin" "$ROOT/versions"; do
        [ ! -e "$removal" ] && [ ! -L "$removal" ] || /bin/rm -R "$removal"
    done
    note "Uninstalled GremVM runtime and launchd wiring. VM data and logs were preserved."
}

monitor_pause() {
    /bin/sleep "$1"
}

runner_active() {
    runner_state=$(/bin/ps -o state= -p "$1" 2> /dev/null || true)
    case $runner_state in
        '' | *Z*) return 1 ;;
        *) return 0 ;;
    esac
}

monitor_guest() {
    runner_pid=$1
    monitor_state=startup
    failed_polls=0

    while runner_active "$runner_pid"; do
        if [ "$(vm_field sshAvailable 2> /dev/null || true)" = true ]; then
            monitor_state=healthy
            failed_polls=0
        else
            failed_polls=$((failed_polls + 1))
            case $monitor_state in
                startup)
                    [ "$failed_polls" -lt "$GUEST_STARTUP_POLLS" ] || return 75
                    ;;
                healthy)
                    [ "$failed_polls" -lt "$GUEST_FAILURE_POLLS" ] || return 75
                    ;;
                *) die "invalid guest monitor state: $monitor_state" ;;
            esac
        fi
        monitor_pause "$GUEST_POLL_SECONDS"
    done
}

stop_supervised_runner() {
    [ -n "$RUNNER_PID" ] || return 0
    kill -TERM "$RUNNER_PID" 2> /dev/null || true
    remaining_polls=$RUNNER_STOP_POLLS
    while runner_active "$RUNNER_PID" && [ "$remaining_polls" -gt 0 ]; do
        monitor_pause 1
        remaining_polls=$((remaining_polls - 1))
    done
    if runner_active "$RUNNER_PID"; then
        kill -KILL "$RUNNER_PID" 2> /dev/null || true
    fi
    wait "$RUNNER_PID" 2> /dev/null || true
    RUNNER_PID=
}

handle_supervisor_signal() {
    trap - HUP INT TERM
    stop_supervised_runner
    exit 0
}

internal_supervise() {
    load_release
    validate_deployment
    if [ "$(provision_state)" != ready ]; then
        /bin/rm -f "$STATE_DIR/READY"
        die "VM is not ready for managed start"
    fi
    firewall_ok || die "Lume's inbound firewall block is missing; refusing to start the VM"
    trap handle_supervisor_signal HUP INT TERM
    "$LUME_BIN" run "$VM_NAME" --no-display --storage "$VM_STORAGE" &
    RUNNER_PID=$!

    if monitor_guest "$RUNNER_PID"; then
        set +e
        wait "$RUNNER_PID"
        runner_status=$?
        set -e
        RUNNER_PID=
        exit "$runner_status"
    fi

    note "Guest remained unavailable; restarting the Lume runner." >&2
    stop_supervised_runner
    exit 75
}

usage() {
    cat << EOF
Usage: $PROGRAM COMMAND

Commands:
  install                         Install pinned Lume and login-time launchd wiring
  provision                       Create the fixed Tahoe VM and disable SIP
  status                          Show VM service state
  start | stop | restart          Control the VM service
  logs                            Read the most recent 200 service log lines
  uninstall                       Remove runtime and launchd wiring; preserve VM data
EOF
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
case $command in
    install)
        [ "$#" -eq 0 ] || die "usage: $PROGRAM install"
        install_command
        ;;
    provision)
        [ "$#" -eq 0 ] || die "usage: $PROGRAM provision"
        provision_command
        ;;
    status)
        [ "$#" -eq 0 ] || die "usage: $PROGRAM status"
        status_command
        ;;
    start)
        [ "$#" -eq 0 ] || die "usage: $PROGRAM start"
        start_command
        ;;
    stop)
        [ "$#" -eq 0 ] || die "usage: $PROGRAM stop"
        stop_command
        ;;
    restart)
        [ "$#" -eq 0 ] || die "usage: $PROGRAM restart"
        restart_command
        ;;
    logs) logs_command "$@" ;;
    uninstall)
        [ "$#" -eq 0 ] || die "usage: $PROGRAM uninstall"
        uninstall_command
        ;;
    internal-supervise)
        [ "$#" -eq 0 ] || die "internal supervisor takes no arguments"
        internal_supervise
        ;;
    help | --help | -h) usage ;;
    *)
        usage >&2
        die "unknown command: $command"
        ;;
esac
