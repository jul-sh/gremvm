#!/bin/sh

set -eu
umask 077

PROGRAM=${0##*/}
LABEL=io.gremvm.lume
HOST_HOME=$HOME
DEFAULT_ROOT=$HOST_HOME/Library/Application\ Support/GremVM
REQUESTED_ROOT=${GREMVM_ROOT:-$DEFAULT_ROOT}
GREMVM_ROOT=$DEFAULT_ROOT
INITIAL_ROOT=$GREMVM_ROOT
CONFIG_PATH=$INITIAL_ROOT/config/gremvm.env

SCRIPT_PATH=$0
case $SCRIPT_PATH in
    */*) ;;
    *) SCRIPT_PATH=$(command -v "$SCRIPT_PATH") || exit 1 ;;
esac
symlink_hops=0
while [ -L "$SCRIPT_PATH" ]; do
    symlink_hops=$((symlink_hops + 1))
    [ "$symlink_hops" -le 20 ] || {
        printf '%s: too many executable symlinks\n' "$PROGRAM" >&2
        exit 1
    }
    link_target=$(/usr/bin/readlink "$SCRIPT_PATH") || exit 1
    case $link_target in
        /*) SCRIPT_PATH=$link_target ;;
        *) SCRIPT_PATH=$(dirname -- "$SCRIPT_PATH")/$link_target ;;
    esac
done
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)
REPO_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd -P)
VERSIONS_FILE=$REPO_ROOT/versions/lume.env
readonly PROGRAM LABEL HOST_HOME DEFAULT_ROOT REQUESTED_ROOT INITIAL_ROOT CONFIG_PATH SCRIPT_DIR REPO_ROOT VERSIONS_FILE

die() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

note() {
    printf '%s\n' "$*"
}

require_command() {
    command -v "$1" > /dev/null 2>&1 || die "required command not found: $1"
}

canonical_future_path() {
    candidate=$1
    suffix=
    while [ ! -e "$candidate" ]; do
        base=${candidate##*/}
        parent=${candidate%/*}
        [ -n "$parent" ] || parent=/
        [ "$parent" != "$candidate" ] || return 1
        suffix=/$base$suffix
        candidate=$parent
    done
    [ -d "$candidate" ] || return 1
    existing=$(CDPATH='' cd -- "$candidate" && pwd -P) || return 1
    printf '%s%s\n' "$existing" "$suffix"
}

load_release() {
    [ -r "$VERSIONS_FILE" ] || die "missing release pin: $VERSIONS_FILE"
    # The release file is repository-controlled and contains assignments only.
    # shellcheck disable=SC1090
    . "$VERSIONS_FILE"
}

load_config() {
    GREMVM_VM_NAME=${GREMVM_VM_NAME:-work}
    GREMVM_VM_STORAGE=${GREMVM_VM_STORAGE:-$GREMVM_ROOT/vms}
    GREMVM_CPU_COUNT=${GREMVM_CPU_COUNT:-4}
    GREMVM_MEMORY=${GREMVM_MEMORY:-8GB}
    GREMVM_DISK_SIZE=${GREMVM_DISK_SIZE:-150GB}
    GREMVM_DISPLAY=${GREMVM_DISPLAY:-1920x1200}
    GREMVM_IPSW=${GREMVM_IPSW:-latest}
    GREMVM_GUEST_ADMIN_USER=${GREMVM_GUEST_ADMIN_USER:-lume}
    GREMVM_SHUTDOWN_TIMEOUT=${GREMVM_SHUTDOWN_TIMEOUT:-75}
    GREMVM_SHUTDOWN_SETTLE_SECONDS=${GREMVM_SHUTDOWN_SETTLE_SECONDS:-20}
    GREMVM_REQUIRE_APPLICATION_FIREWALL=${GREMVM_REQUIRE_APPLICATION_FIREWALL:-true}
    if [ -r "$CONFIG_PATH" ]; then
        # This file is created mode 0600 for the owning user. It deliberately
        # supports quoted paths and is therefore sourced rather than parsed.
        # shellcheck disable=SC1090
        . "$CONFIG_PATH"
    fi

    [ "$REQUESTED_ROOT" = "$DEFAULT_ROOT" ] || die "GREMVM_ROOT is fixed at $DEFAULT_ROOT"
    [ "$HOME" = "$HOST_HOME" ] || die "the deployment config may not change HOME"
    [ "$GREMVM_ROOT" = "$INITIAL_ROOT" ] || die "the deployment config may not change GREMVM_ROOT"
    GREMVM_LUME_BIN=$GREMVM_ROOT/runtime/current/lume.app/Contents/MacOS/lume
    GREMVM_LAUNCH_AGENT=$HOST_HOME/Library/LaunchAgents/$LABEL.plist
    GREMVM_LOG_DIR=$GREMVM_ROOT/logs
    GREMVM_STATE_DIR=$GREMVM_ROOT/state
    GREMVM_SSH_DIR=$GREMVM_ROOT/ssh

    case $GREMVM_ROOT in
        "$HOST_HOME"/*) ;;
        *) die "GREMVM_ROOT must stay inside the owning user's home directory" ;;
    esac
    case /$GREMVM_ROOT/ in
        */../* | */./*) die "GREMVM_ROOT may not contain dot path components" ;;
    esac
    [ "$GREMVM_ROOT" != "$HOME" ] || die "GREMVM_ROOT may not be the home directory itself"
    canonical_home=$(CDPATH='' cd -- "$HOST_HOME" && pwd -P) || die "HOME must resolve to a directory"
    resolved_root=$(canonical_future_path "$GREMVM_ROOT") || die "GREMVM_ROOT must resolve through directories"
    root_suffix=${GREMVM_ROOT#"$HOST_HOME"}
    [ "$resolved_root" = "$canonical_home$root_suffix" ] || die "GREMVM_ROOT may not traverse symbolic links below HOME"

    case $GREMVM_VM_NAME in
        [A-Za-z0-9]*) ;;
        *) die "VM name must begin with an ASCII letter or digit: $GREMVM_VM_NAME" ;;
    esac
    case $GREMVM_VM_NAME in
        *[!A-Za-z0-9._-]*) die "invalid VM name in $CONFIG_PATH: $GREMVM_VM_NAME" ;;
    esac
    case $GREMVM_VM_STORAGE in
        /*) ;;
        *) die "GREMVM_VM_STORAGE must be an absolute path" ;;
    esac
    case /$GREMVM_VM_STORAGE/ in
        */../* | */./*) die "GREMVM_VM_STORAGE may not contain dot path components" ;;
    esac
    [ "$GREMVM_VM_STORAGE" != / ] || die "GREMVM_VM_STORAGE may not be the filesystem root"
    resolved_storage=$(canonical_future_path "$GREMVM_VM_STORAGE") || die "GREMVM_VM_STORAGE must resolve through directories"
    case $GREMVM_VM_STORAGE in
        "$HOST_HOME"/*)
            storage_suffix=${GREMVM_VM_STORAGE#"$HOST_HOME"}
            expected_storage=$canonical_home$storage_suffix
            ;;
        *) expected_storage=$GREMVM_VM_STORAGE ;;
    esac
    [ "$resolved_storage" = "$expected_storage" ] || die "GREMVM_VM_STORAGE may not traverse symbolic links"
    [ ! -L "$GREMVM_VM_STORAGE/$GREMVM_VM_NAME" ] || die "VM directory may not be a symbolic link"
    case $GREMVM_SHUTDOWN_TIMEOUT in
        '' | *[!0-9]*) die "GREMVM_SHUTDOWN_TIMEOUT must be a positive integer" ;;
    esac
    [ "$GREMVM_SHUTDOWN_TIMEOUT" -gt 0 ] || die "GREMVM_SHUTDOWN_TIMEOUT must be greater than zero"
    case $GREMVM_SHUTDOWN_SETTLE_SECONDS in
        '' | *[!0-9]*) die "GREMVM_SHUTDOWN_SETTLE_SECONDS must be a non-negative integer" ;;
    esac
    [ "$GREMVM_SHUTDOWN_TIMEOUT" -le 600 ] || die "GREMVM_SHUTDOWN_TIMEOUT may not exceed 600 seconds"
    [ "$GREMVM_SHUTDOWN_SETTLE_SECONDS" -le 300 ] || die "GREMVM_SHUTDOWN_SETTLE_SECONDS may not exceed 300 seconds"
    case $GREMVM_CPU_COUNT in
        '' | *[!0-9]*) die "GREMVM_CPU_COUNT must be a positive integer" ;;
    esac
    [ "$GREMVM_CPU_COUNT" -gt 0 ] || die "GREMVM_CPU_COUNT must be greater than zero"
    case $GREMVM_MEMORY in
        '' | *[!A-Za-z0-9]*) die "GREMVM_MEMORY must contain only a size and unit" ;;
    esac
    case $GREMVM_DISK_SIZE in
        '' | *[!A-Za-z0-9]*) die "GREMVM_DISK_SIZE must contain only a size and unit" ;;
    esac
    case $GREMVM_IPSW in
        latest | /*) ;;
        *) die "GREMVM_IPSW must be 'latest' or an absolute local IPSW path" ;;
    esac
    display_width=${GREMVM_DISPLAY%x*}
    display_height=${GREMVM_DISPLAY#*x}
    [ "$display_width"x"$display_height" = "$GREMVM_DISPLAY" ] || die "GREMVM_DISPLAY must be WIDTHxHEIGHT"
    case $display_width in
        '' | *[!0-9]*) die "GREMVM_DISPLAY must be WIDTHxHEIGHT" ;;
    esac
    case $display_height in
        '' | *[!0-9]*) die "GREMVM_DISPLAY must be WIDTHxHEIGHT" ;;
    esac
    [ "$display_width" -gt 0 ] && [ "$display_height" -gt 0 ] || die "GREMVM_DISPLAY dimensions must be positive"
    case $GREMVM_REQUIRE_APPLICATION_FIREWALL in
        true | false) ;;
        *) die "GREMVM_REQUIRE_APPLICATION_FIREWALL must be true or false" ;;
    esac
    [ "$GREMVM_GUEST_ADMIN_USER" = lume ] || die "Lume unattended setup requires GREMVM_GUEST_ADMIN_USER=lume"
}

lume() {
    [ -x "$GREMVM_LUME_BIN" ] || die "Lume is not installed; run '$PROGRAM install'"
    LUME_LOG_LEVEL=${LUME_LOG_LEVEL:-error} LUME_TELEMETRY_ENABLED=false "$GREMVM_LUME_BIN" "$@"
}

service_target() {
    printf 'gui/%s/%s\n' "$(id -u)" "$LABEL"
}

service_loaded() {
    launchctl print "$(service_target)" > /dev/null 2>&1
}

vm_exists() {
    lume get "$GREMVM_VM_NAME" --storage "$GREMVM_VM_STORAGE" --format json > /dev/null 2>&1
}

vm_json() {
    lume get "$GREMVM_VM_NAME" --storage "$GREMVM_VM_STORAGE" --format json 2> /dev/null
}

vm_field() {
    field=$1
    json=$(vm_json) || return 1
    printf '%s' "$json" | /usr/bin/plutil -extract "0.$field" raw -o - - 2> /dev/null
}

xml_escape() {
    /usr/bin/sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' -e "s/'/\&apos;/g"
}

verify_lume_bundle() {
    release_dir=$1
    [ -d "$release_dir/lume.app" ] || return 1
    signed_lume=$release_dir/lume.app/Contents/MacOS/lume
    [ -x "$signed_lume" ] || return 1
    /usr/bin/codesign --verify --deep --strict "$release_dir/lume.app" > /dev/null 2>&1 || return 1
    /usr/sbin/spctl --assess --type execute "$release_dir/lume.app" > /dev/null 2>&1 || return 1
    signature=$(/usr/bin/codesign -dv --verbose=4 "$release_dir/lume.app" 2>&1) || return 1
    team=$(printf '%s\n' "$signature" | /usr/bin/awk -F= '$1 == "TeamIdentifier" { print $2 }')
    identifier=$(printf '%s\n' "$signature" | /usr/bin/awk -F= '$1 == "Identifier" { print $2 }')
    [ "$team" = "$LUME_TEAM_ID" ] || return 1
    [ "$identifier" = "$LUME_BUNDLE_ID" ] || return 1
    printf '%s\n' "$signature" | /usr/bin/grep -Eq '^CodeDirectory .*flags=.*\(runtime\)' || return 1
    reported=$(LUME_TELEMETRY_ENABLED=false "$signed_lume" --version 2> /dev/null) || return 1
    [ "$reported" = "$LUME_VERSION" ]
}

prepare_lume_release() (
    runtime_dir=$GREMVM_ROOT/runtime
    release_dir=$runtime_dir/lume-$LUME_VERSION
    mkdir -p "$runtime_dir"
    chmod 700 "$runtime_dir"

    if [ -e "$release_dir" ]; then
        verify_lume_bundle "$release_dir" || die "existing Lume runtime failed verification: $release_dir"
    else
        require_command curl
        require_command shasum
        staging=$(mktemp -d "$runtime_dir/.install.XXXXXX")
        archive=$staging/lume.tar.gz
        # shellcheck disable=SC2329 # Called asynchronously by the EXIT trap below.
        cleanup_install() {
            /bin/rm -R "$staging"
        }
        trap cleanup_install EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM

        note "Downloading pinned Lume $LUME_VERSION..."
        curl -fL --retry 3 --proto '=https' --tlsv1.2 -o "$archive" "$LUME_ARCHIVE_URL"
        actual=$(/usr/bin/shasum -a 256 "$archive" | /usr/bin/awk '{print $1}')
        [ "$actual" = "$LUME_ARCHIVE_SHA256" ] || die "Lume archive checksum mismatch"

        mkdir "$staging/unpack"
        /usr/bin/tar -xzf "$archive" -C "$staging/unpack"
        verify_lume_bundle "$staging/unpack" || die "Lume signature, hardened runtime, Gatekeeper, identity, or version verification failed"
        /bin/mv "$staging/unpack" "$release_dir"
        trap - EXIT HUP INT TERM
        /bin/rm -R "$staging"
    fi

)

activate_lume_release() {
    runtime_dir=$GREMVM_ROOT/runtime
    release_dir=$runtime_dir/lume-$LUME_VERSION
    verify_lume_bundle "$release_dir" || die "prepared Lume runtime failed verification: $release_dir"
    if [ -e "$runtime_dir/current" ] && [ ! -L "$runtime_dir/current" ]; then
        die "refusing to replace non-symlink Lume activation path: $runtime_dir/current"
    fi
    next_link=$runtime_dir/.current.$$
    /bin/ln -s "lume-$LUME_VERSION" "$next_link"
    /bin/mv -f -h "$next_link" "$runtime_dir/current"
    [ -L "$runtime_dir/current" ] || die "Lume activation path is not a symbolic link"
    verify_lume_bundle "$runtime_dir/current" || die "activated Lume runtime failed verification"
}

write_default_config() {
    storage_created=false
    if [ ! -d "$GREMVM_VM_STORAGE" ]; then
        mkdir -p "$GREMVM_VM_STORAGE"
        storage_created=true
    fi
    mkdir -p "$GREMVM_ROOT/config" "$GREMVM_LOG_DIR" "$GREMVM_STATE_DIR" "$GREMVM_SSH_DIR"
    chmod 700 "$GREMVM_ROOT" "$GREMVM_ROOT/config" "$GREMVM_LOG_DIR" "$GREMVM_STATE_DIR" "$GREMVM_SSH_DIR"
    [ "$storage_created" = false ] || chmod 700 "$GREMVM_VM_STORAGE"
    load_config
    if [ ! -e "$CONFIG_PATH" ]; then
        config_tmp=$GREMVM_ROOT/config/.gremvm.env.$$
        umask 077
        {
            printf '# GremVM deployment configuration.\n'
            printf 'GREMVM_VM_NAME=%s\n' "$GREMVM_VM_NAME"
            printf "GREMVM_VM_STORAGE='%s'\n" "$(printf '%s' "$GREMVM_VM_STORAGE" | /usr/bin/sed "s/'/'\\\\''/g")"
            printf 'GREMVM_CPU_COUNT=%s\n' "$GREMVM_CPU_COUNT"
            printf 'GREMVM_MEMORY=%s\n' "$GREMVM_MEMORY"
            printf 'GREMVM_DISK_SIZE=%s\n' "$GREMVM_DISK_SIZE"
            printf 'GREMVM_DISPLAY=%s\n' "$GREMVM_DISPLAY"
            printf "GREMVM_IPSW='%s'\n" "$(printf '%s' "$GREMVM_IPSW" | /usr/bin/sed "s/'/'\\\\''/g")"
            printf 'GREMVM_GUEST_ADMIN_USER=%s\n' "$GREMVM_GUEST_ADMIN_USER"
            printf 'GREMVM_SHUTDOWN_TIMEOUT=%s\n' "$GREMVM_SHUTDOWN_TIMEOUT"
            printf 'GREMVM_SHUTDOWN_SETTLE_SECONDS=%s\n' "$GREMVM_SHUTDOWN_SETTLE_SECONDS"
            printf 'GREMVM_REQUIRE_APPLICATION_FIREWALL=%s\n' "$GREMVM_REQUIRE_APPLICATION_FIREWALL"
        } > "$config_tmp"
        chmod 600 "$config_tmp"
        /bin/mv "$config_tmp" "$CONFIG_PATH"
    fi
}

write_launch_agent() {
    mkdir -p "$HOME/Library/LaunchAgents" "$GREMVM_LOG_DIR"
    chmod 700 "$GREMVM_LOG_DIR"
    /usr/bin/touch "$GREMVM_LOG_DIR/vm.log" "$GREMVM_LOG_DIR/vm.error.log"
    chmod 600 "$GREMVM_LOG_DIR/vm.log" "$GREMVM_LOG_DIR/vm.error.log"

    plist_tmp=$HOME/Library/LaunchAgents/.$LABEL.$$.plist
    cli_path=$GREMVM_ROOT/bin/gremvm
    cli_xml=$(printf '%s' "$cli_path" | xml_escape)
    home_xml=$(printf '%s' "$HOME" | xml_escape)
    root_xml=$(printf '%s' "$GREMVM_ROOT" | xml_escape)
    ready_xml=$(printf '%s' "$GREMVM_STATE_DIR/READY" | xml_escape)
    exit_timeout=$((GREMVM_SHUTDOWN_TIMEOUT + GREMVM_SHUTDOWN_SETTLE_SECONDS + 60))
    /usr/bin/plutil -create xml1 "$plist_tmp"
    /usr/bin/plutil -insert Label -string "$LABEL" "$plist_tmp"
    /usr/bin/plutil -insert ProgramArguments -xml "<array><string>$cli_xml</string><string>internal-supervise</string></array>" "$plist_tmp"
    /usr/bin/plutil -insert KeepAlive -xml "<dict><key>PathState</key><dict><key>$ready_xml</key><true/></dict></dict>" "$plist_tmp"
    /usr/bin/plutil -insert ThrottleInterval -integer 20 "$plist_tmp"
    /usr/bin/plutil -insert ExitTimeOut -integer "$exit_timeout" "$plist_tmp"
    /usr/bin/plutil -insert ProcessType -string Interactive "$plist_tmp"
    /usr/bin/plutil -insert LimitLoadToSessionType -string Aqua "$plist_tmp"
    /usr/bin/plutil -insert WorkingDirectory -string "$HOME" "$plist_tmp"
    /usr/bin/plutil -insert StandardOutPath -string "$GREMVM_LOG_DIR/vm.log" "$plist_tmp"
    /usr/bin/plutil -insert StandardErrorPath -string "$GREMVM_LOG_DIR/vm.error.log" "$plist_tmp"
    /usr/bin/plutil -insert EnvironmentVariables -xml "<dict><key>HOME</key><string>$home_xml</string><key>GREMVM_ROOT</key><string>$root_xml</string><key>LUME_TELEMETRY_ENABLED</key><string>false</string><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>" "$plist_tmp"
    /usr/bin/plutil -lint "$plist_tmp" > /dev/null
    chmod 644 "$plist_tmp"
    /bin/mv "$plist_tmp" "$GREMVM_LAUNCH_AGENT"
}

firewall_ok() {
    load_release
    load_config
    [ "$GREMVM_REQUIRE_APPLICATION_FIREWALL" = true ] || return 0
    firewall=/usr/libexec/ApplicationFirewall/socketfilterfw
    [ -x "$firewall" ] || return 1
    global=$($firewall --getglobalstate 2> /dev/null || true)
    case $global in
        *'State = 1'*) ;;
        *) return 1 ;;
    esac
    app=$GREMVM_ROOT/runtime/lume-$LUME_VERSION/lume.app
    blocked=$($firewall --getappblocked "$app" 2> /dev/null || true)
    case $blocked in
        *' is blocked.'*) return 0 ;;
        *) return 1 ;;
    esac
}

configure_firewall() {
    if [ "$GREMVM_REQUIRE_APPLICATION_FIREWALL" != true ]; then
        note "WARNING: GREMVM_REQUIRE_APPLICATION_FIREWALL=false; Lume's VNC listener is not host-firewall-gated." >&2
        return 0
    fi
    firewall=/usr/libexec/ApplicationFirewall/socketfilterfw
    [ -x "$firewall" ] || die "macOS Application Firewall control tool is unavailable"
    global=$($firewall --getglobalstate 2> /dev/null || true)
    case $global in
        *'State = 1'*) ;;
        *)
            die "macOS Application Firewall is disabled. Enable it in System Settings (or with 'sudo $firewall --setglobalstate on'), then rerun install. GremVM will not expose Lume's VNC listener without this boundary."
            ;;
    esac
    app=$GREMVM_ROOT/runtime/lume-$LUME_VERSION/lume.app
    note "Adding a deny-inbound Application Firewall rule for Lume (administrator approval may be requested)..."
    sudo "$firewall" --add "$app" > /dev/null 2>&1 || true
    sudo "$firewall" --blockapp "$app" > /dev/null
    firewall_ok || die "the deny-inbound Lume firewall rule could not be verified"
}

firewall_check_command() {
    load_config
    if [ "$GREMVM_REQUIRE_APPLICATION_FIREWALL" = false ]; then
        note "firewall: enforcement-explicitly-disabled"
        return 0
    fi
    if firewall_ok; then
        note "firewall: enabled-and-lume-blocked"
    else
        note "firewall: unsafe-or-unverified"
        return 1
    fi
}

require_qualified_host() {
    host_version=$(/usr/bin/sw_vers -productVersion) || die "could not determine the host macOS version"
    host_major=${host_version%%.*}
    case $host_major in
        '' | *[!0-9]*) die "unrecognized host macOS version: $host_version" ;;
    esac
    [ "$host_major" -ge 26 ] ||
        die "this deployment requires macOS 26 or newer because Lume 0.4.0 verifies unattended Recovery/SIP only for a Tahoe guest"
}

validate_guest_source() {
    require_qualified_host
    host_version=$(/usr/bin/sw_vers -productVersion)
    host_major=${host_version%%.*}
    if [ "$GREMVM_IPSW" = latest ]; then
        [ "$host_major" -eq 26 ] ||
            die "GREMVM_IPSW=latest is qualified only on a macOS 26 host; configure an absolute, reviewed macOS 26 (Tahoe) IPSW path"
        return 0
    fi
    [ -f "$GREMVM_IPSW" ] || die "configured IPSW does not exist: $GREMVM_IPSW"
    ipsw_version=$(
        /usr/bin/unzip -p "$GREMVM_IPSW" BuildManifest.plist 2> /dev/null |
            /usr/bin/plutil -extract ProductVersion raw -o - - 2> /dev/null
    ) || die "could not read ProductVersion from configured IPSW: $GREMVM_IPSW"
    case $ipsw_version in
        26.*) ;;
        *) die "Lume 0.4.0's qualified SIP workflow requires a macOS 26 (Tahoe) IPSW, not $ipsw_version" ;;
    esac
}

install_command() {
    [ "$(uname -s)" = Darwin ] || die "the host must be macOS"
    [ "$(uname -m)" = arm64 ] || die "Lume requires an Apple-silicon Mac"
    require_qualified_host
    load_release
    load_config
    write_default_config
    prepare_lume_release
    configure_firewall

    was_loaded=false
    if service_loaded; then
        was_loaded=true
        stop_command
    fi

    mkdir -p "$GREMVM_ROOT/bin" "$GREMVM_ROOT/versions"
    chmod 700 "$GREMVM_ROOT/bin" "$GREMVM_ROOT/versions"
    cli_tmp=$GREMVM_ROOT/bin/.gremvm.$$
    /usr/bin/install -m 755 "$REPO_ROOT/bin/gremvm" "$cli_tmp"
    /bin/mv "$cli_tmp" "$GREMVM_ROOT/bin/gremvm"
    /usr/bin/install -m 600 "$VERSIONS_FILE" "$GREMVM_ROOT/versions/lume.env"

    activate_lume_release
    GREMVM_LUME_BIN=$GREMVM_ROOT/runtime/current/lume.app/Contents/MacOS/lume
    LUME_TELEMETRY_ENABLED=false "$GREMVM_LUME_BIN" config telemetry disable > /dev/null
    write_launch_agent

    mkdir -p "$HOME/.local/bin"
    convenience_link=$HOME/.local/bin/gremvm
    if [ ! -e "$convenience_link" ] && [ ! -L "$convenience_link" ]; then
        /bin/ln -sfn "$GREMVM_ROOT/bin/gremvm" "$HOME/.local/bin/gremvm"
    elif [ -L "$convenience_link" ] && [ "$(readlink "$convenience_link")" = "$GREMVM_ROOT/bin/gremvm" ]; then
        /bin/ln -sfn "$GREMVM_ROOT/bin/gremvm" "$convenience_link"
    else
        note "Not replacing existing $convenience_link; use $GREMVM_ROOT/bin/gremvm"
    fi

    if [ "$was_loaded" = true ] && vm_exists; then
        start_command
    fi
    note "Installed GremVM's Lume deployment layer. VM data is stored at: $GREMVM_VM_STORAGE"
    note "Next: $GREMVM_ROOT/bin/gremvm provision"
}

make_shutdown_key() {
    create_missing=${1:-false}
    private_key=$GREMVM_SSH_DIR/guest-shutdown
    public_key=$private_key.pub
    if [ -e "$private_key" ] && [ ! -e "$public_key" ]; then
        die "shutdown private key exists without its public key: $private_key"
    fi
    if [ ! -e "$private_key" ] && [ -e "$public_key" ]; then
        die "shutdown public key exists without its private key: $public_key"
    fi
    if [ ! -e "$private_key" ]; then
        [ "$create_missing" = true ] || die "managed shutdown key is missing: $private_key"
        /usr/bin/ssh-keygen -q -t ed25519 -N '' -C "$LABEL@$(/bin/hostname -s)" -f "$private_key"
    fi
    chmod 600 "$private_key"
    chmod 644 "$public_key"
    derived_public=$(/usr/bin/ssh-keygen -y -f "$private_key") || die "shutdown private key is unreadable"
    recorded_public=$(/usr/bin/awk '{print $1 " " $2}' "$public_key")
    [ "$derived_public" = "$recorded_public" ] || die "shutdown public/private keys do not correspond"
}

write_unattended_config() {
    public_key=$(cat "$GREMVM_SSH_DIR/guest-shutdown.pub")
    forced_line="command=\"sudo -n /sbin/shutdown -h now\",no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding $public_key"
    authorized_b64=$(printf '%s\n' "$forced_line" | /usr/bin/base64 | /usr/bin/tr -d '\n')
    sudoers_b64=$(printf '%s\n' "$GREMVM_GUEST_ADMIN_USER ALL=(root) NOPASSWD: /sbin/shutdown -h now" | /usr/bin/base64 | /usr/bin/tr -d '\n')
    unattended=$GREMVM_STATE_DIR/unattended.yml
    umask 077
    {
        printf 'boot_wait: 0\n'
        printf 'boot_commands: []\n'
        printf 'health_check:\n'
        printf '  type: ssh\n'
        printf '  user: lume\n'
        printf '  password: lume\n'
        printf '  timeout: 5\n'
        printf '  retries: 60\n'
        printf '  retry_delay: 5\n'
        printf 'post_ssh_commands:\n'
        printf '  - "umask 077; mkdir -p ~/.ssh; printf %%s %s | /usr/bin/base64 -D >> ~/.ssh/authorized_keys; chmod 700 ~/.ssh; chmod 600 ~/.ssh/authorized_keys"\n' "$authorized_b64"
        printf "  - \"sudo /bin/sh -c 'printf %%s %s | /usr/bin/base64 -D > /etc/sudoers.d/gremvm-shutdown; /bin/chmod 440 /etc/sudoers.d/gremvm-shutdown; /usr/sbin/visudo -cf /etc/sudoers.d/gremvm-shutdown'\"\n" "$sudoers_b64"
    } > "$unattended"
    chmod 600 "$unattended"
    printf '%s\n' "$unattended"
}

pin_guest_host_key() {
    ip=$1
    known_hosts=$GREMVM_SSH_DIR/known_hosts
    scan_tmp=$GREMVM_SSH_DIR/.known_hosts.$$
    /usr/bin/ssh-keyscan -T 10 -t ed25519 "$ip" 2> /dev/null |
        /usr/bin/sed "s/^$ip /$GREMVM_VM_NAME /" > "$scan_tmp"
    [ -s "$scan_tmp" ] || {
        /bin/rm -f "$scan_tmp"
        return 1
    }
    chmod 600 "$scan_tmp"
    /bin/mv "$scan_tmp" "$known_hosts"
}

wait_for_ssh() {
    limit=${1:-300}
    elapsed=0
    while [ "$elapsed" -lt "$limit" ]; do
        status=$(vm_field status 2> /dev/null || true)
        ssh_available=$(vm_field sshAvailable 2> /dev/null || true)
        ip=$(vm_field ipAddress 2> /dev/null || true)
        if [ "$status" = running ] && [ "$ssh_available" = true ] && [ -n "$ip" ]; then
            printf '%s\n' "$ip"
            return 0
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
    return 1
}

request_guest_shutdown() {
    private_key=$GREMVM_SSH_DIR/guest-shutdown
    known_hosts=$GREMVM_SSH_DIR/known_hosts
    [ -r "$private_key" ] || return 1
    [ -r "$known_hosts" ] || return 1
    ip=$(vm_field ipAddress 2> /dev/null || true)
    ssh_available=$(vm_field sshAvailable 2> /dev/null || true)
    [ -n "$ip" ] || return 1
    [ "$ssh_available" = true ] || return 1

    /usr/bin/ssh \
        -T \
        -o BatchMode=yes \
        -o ConnectTimeout=8 \
        -o HostKeyAlias="$GREMVM_VM_NAME" \
        -o IdentitiesOnly=yes \
        -o StrictHostKeyChecking=yes \
        -o UserKnownHostsFile="$known_hosts" \
        -i "$private_key" \
        "$GREMVM_GUEST_ADMIN_USER@$ip" < /dev/null > /dev/null 2>&1 || true

    # Lume 0.4.0 keeps its foreground run process alive after a guest-initiated
    # halt. Its reported state therefore cannot be used as the clean-shutdown
    # witness. Require Remote Login to disappear repeatedly after the
    # authenticated shutdown request, then allow a configurable disk-settle
    # interval before the owning runner may be reaped.
    elapsed=0
    offline_polls=0
    while [ "$elapsed" -lt "$GREMVM_SHUTDOWN_TIMEOUT" ]; do
        ssh_available=$(vm_field sshAvailable 2> /dev/null || true)
        if [ "$ssh_available" != true ]; then
            offline_polls=$((offline_polls + 1))
            if [ "$offline_polls" -ge 5 ]; then
                sleep "$GREMVM_SHUTDOWN_SETTLE_SECONDS"
                [ "$(vm_field sshAvailable 2> /dev/null || true)" != true ]
                return
            fi
        else
            offline_polls=0
        fi
        sleep 3
        elapsed=$((elapsed + 3))
    done
    return 1
}

stop_lume_runner() {
    if lume stop "$GREMVM_VM_NAME" --storage "$GREMVM_VM_STORAGE" > /dev/null 2>&1; then
        return 0
    fi
    [ "$(vm_field status 2> /dev/null || true)" = stopped ]
}

process_identity() {
    process_pid=$1
    started=$(/bin/ps -p "$process_pid" -o lstart= 2> /dev/null || true)
    [ -n "$started" ] || return 1
    printf '%s' "$started" | /usr/bin/cksum | /usr/bin/awk '{print $1}'
}

write_runner_owner() {
    runner_pid=$1
    runner_identity=$(process_identity "$runner_pid") || return 1
    case $runner_identity in
        '' | *[!0-9]*) return 1 ;;
    esac
    runner_owner=$runner_pid:$runner_identity
    runner_owner_tmp=$GREMVM_STATE_DIR/.runner-owner.$$
    printf '%s\n' "$runner_owner" > "$runner_owner_tmp"
    /bin/mv "$runner_owner_tmp" "$GREMVM_STATE_DIR/runner-owner"
    chmod 600 "$GREMVM_STATE_DIR/runner-owner"
    printf '%s\n' "$runner_owner"
}

clear_runner_owner() {
    expected_owner=$1
    owner_file=$GREMVM_STATE_DIR/runner-owner
    observed_owner=$(cat "$owner_file" 2> /dev/null || true)
    [ "$observed_owner" = "$expected_owner" ] && /bin/rm -f "$owner_file"
    return 0
}

terminate_managed_runner() {
    owner_file=$GREMVM_STATE_DIR/runner-owner
    observed_owner=$(cat "$owner_file" 2> /dev/null || true)
    runner_pid=${observed_owner%%:*}
    runner_started=${observed_owner#*:}
    case $observed_owner in
        '' | *[!0-9:]* | *:*:* | :* | *:) return 1 ;;
    esac
    current_identity=$(process_identity "$runner_pid" 2> /dev/null || true)
    [ "$runner_started" = "$current_identity" ] || return 1
    kill -0 "$runner_pid" 2> /dev/null || return 1
    kill -TERM "$runner_pid"
}

wait_for_lume_stopped() {
    limit=${1:-20}
    elapsed=0
    while [ "$elapsed" -lt "$limit" ]; do
        [ "$(vm_field status 2> /dev/null || true)" = stopped ] && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 1
}

maintenance_active() {
    lock_path=$GREMVM_STATE_DIR/maintenance.lock
    [ -d "$lock_path" ] || return 1
    observed_owner=$(cat "$lock_path/owner" 2> /dev/null || true)
    owner_pid=${observed_owner%%:*}
    owner_started=${observed_owner#*:}
    case $observed_owner in
        '' | *[!0-9:]* | *:*:* | :* | *:) owner_alive=false ;;
        *)
            current_identity=$(process_identity "$owner_pid" 2> /dev/null || true)
            if [ "$owner_started" = "$current_identity" ] && kill -0 "$owner_pid" 2> /dev/null; then
                owner_alive=true
            else
                owner_alive=false
            fi
            ;;
    esac
    if [ "$owner_alive" = true ]; then
        [ -n "${lock_owner:-}" ] && [ "$observed_owner" = "$lock_owner" ] && return 1
        return 0
    fi
    /bin/rm -f "$lock_path/owner"
    rmdir "$lock_path" 2> /dev/null || return 0
    return 1
}

write_provision_state() {
    next_state=$1
    case $next_state in
        creating | created | sip-disabled | ready) ;;
        *) die "invalid provision state transition target: $next_state" ;;
    esac
    state_tmp=$GREMVM_STATE_DIR/.provision-state.$$
    printf '%s\n' "$next_state" > "$state_tmp"
    /bin/mv "$state_tmp" "$GREMVM_STATE_DIR/provision-state"
    if [ "$next_state" = ready ]; then
        /usr/bin/touch "$GREMVM_STATE_DIR/READY"
        chmod 600 "$GREMVM_STATE_DIR/READY"
    else
        /bin/rm -f "$GREMVM_STATE_DIR/READY"
    fi
}

provision_state() {
    state_file=$GREMVM_STATE_DIR/provision-state
    if [ -e "$state_file" ]; then
        [ -r "$state_file" ] || die "provision state is unreadable: $state_file"
        recorded_state=$(cat "$state_file")
        case $recorded_state in
            creating)
                printf '%s\n' creating
                ;;
            created | sip-disabled | ready)
                if vm_exists; then
                    printf '%s\n' "$recorded_state"
                else
                    printf '%s\n' managed-vm-missing
                fi
                ;;
            *) die "unknown provision state in $state_file: $recorded_state" ;;
        esac
    elif vm_exists; then
        printf '%s\n' foreign-vm
    else
        printf '%s\n' absent
    fi
}

verify_shutdown_access() (
    provision_log=$GREMVM_LOG_DIR/provision-verification.log
    runner_pid=
    runner_active=false
    # shellcheck disable=SC2329 # Called asynchronously by the EXIT trap below.
    verification_cleanup() {
        if [ "$runner_active" = true ]; then
            stop_lume_runner > /dev/null 2>&1 || true
            [ -z "$runner_pid" ] || kill -TERM "$runner_pid" 2> /dev/null || true
            [ -z "$runner_pid" ] || wait "$runner_pid" 2> /dev/null || true
        fi
    }
    trap verification_cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    LUME_LOG_LEVEL=error LUME_TELEMETRY_ENABLED=false "$GREMVM_LUME_BIN" run "$GREMVM_VM_NAME" --no-display --network nat --storage "$GREMVM_VM_STORAGE" > "$provision_log" 2>&1 &
    runner_pid=$!
    runner_active=true
    ip=$(wait_for_ssh 300) || die "VM did not become SSH-ready; see $provision_log"
    pin_guest_host_key "$ip" || die "could not pin the guest SSH host key"
    request_guest_shutdown || die "shutdown-only guest key verification failed"
    if kill -0 "$runner_pid" 2> /dev/null; then
        kill -TERM "$runner_pid" || die "could not reap the stopped Lume verification runner"
    fi
    wait "$runner_pid" 2> /dev/null || true
    runner_active=false
    wait_for_lume_stopped 20 || die "Lume did not release the stopped VM after verification"
    trap - EXIT HUP INT TERM
)

provision_command() {
    load_release
    load_config
    [ -x "$GREMVM_LUME_BIN" ] || die "run '$PROGRAM install' first"
    firewall_ok || die "Lume's inbound firewall block is missing; rerun '$PROGRAM install'"
    require_command vncdo
    while :; do
        state=$(provision_state)
        case $state in
            absent)
                validate_guest_source
                make_shutdown_key true
                write_provision_state creating
                ;;
            creating)
                make_shutdown_key true
                if vm_exists; then
                    for required in disk.img nvram.bin config.json; do
                        [ -f "$GREMVM_VM_STORAGE/$GREMVM_VM_NAME/$required" ] ||
                            die "Lume creation was interrupted before $required existed; partial VM data was preserved for inspection"
                    done
                    write_provision_state created
                else
                    unattended=$(write_unattended_config)
                    validate_guest_source
                    note "Creating a vanilla macOS VM from Apple's current supported restore image. This can take a while."
                    lume create "$GREMVM_VM_NAME" \
                        --os macOS \
                        --ipsw "$GREMVM_IPSW" \
                        --unattended "$unattended" \
                        --cpu "$GREMVM_CPU_COUNT" \
                        --memory "$GREMVM_MEMORY" \
                        --disk-size "$GREMVM_DISK_SIZE" \
                        --display "$GREMVM_DISPLAY" \
                        --network nat \
                        --storage "$GREMVM_VM_STORAGE"
                    write_provision_state created
                fi
                ;;
            created)
                make_shutdown_key false
                note "Disabling SIP through the VM's paired Recovery environment..."
                printf 'lume\n' | lume sip off "$GREMVM_VM_NAME" \
                    --yes \
                    --admin-user lume \
                    --admin-password-stdin \
                    --storage "$GREMVM_VM_STORAGE"
                write_provision_state sip-disabled
                ;;
            sip-disabled)
                make_shutdown_key false
                verify_shutdown_access
                printf '%s\n' 'Change the default guest password before installing remote access.' > "$GREMVM_STATE_DIR/NEEDS-GUEST-HARDENING"
                /bin/rm -f "$GREMVM_STATE_DIR/unattended.yml"
                write_provision_state ready
                ;;
            ready)
                make_shutdown_key false
                start_command
                note "Provisioned '$GREMVM_VM_NAME' with SIP disabled and verified clean shutdown access."
                note "SECURITY NEXT STEP: run '$PROGRAM console', change the guest's lume/lume password, then configure the private remote-access path in docs/REMOTE_ACCESS.md."
                return 0
                ;;
            foreign-vm)
                die "VM '$GREMVM_VM_NAME' exists without GremVM provision state; preserving it and refusing automatic adoption"
                ;;
            managed-vm-missing)
                /bin/rm -f "$GREMVM_STATE_DIR/READY"
                die "GremVM provision state exists but VM '$GREMVM_VM_NAME' is missing; refusing to recreate it implicitly"
                ;;
            *) die "unhandled provision state: $state" ;;
        esac
    done
}

start_command() {
    load_release
    load_config
    [ -r "$GREMVM_LAUNCH_AGENT" ] || die "not installed; run '$PROGRAM install'"
    state=$(provision_state)
    [ "$state" = ready ] || die "VM '$GREMVM_VM_NAME' is not ready (provision-state: $state)"
    firewall_ok || die "Lume's inbound firewall block is missing; rerun '$PROGRAM install'"
    ! maintenance_active || die "a backup or lifecycle maintenance operation is active"
    if service_loaded; then
        note "VM supervisor is already loaded."
        return 0
    fi
    release_maintenance_lock
    launchctl bootstrap "gui/$(id -u)" "$GREMVM_LAUNCH_AGENT"
    note "VM supervisor started."
}

stop_command() {
    load_config
    ! maintenance_active || die "a backup or lifecycle maintenance operation is active"
    if service_loaded; then
        last_stop=$GREMVM_STATE_DIR/last-stop
        /bin/rm -f "$last_stop"
        launchctl bootout --wait "$(service_target)"
        stop_result=$(/usr/bin/sed -n '1s/ .*//p' "$last_stop" 2> /dev/null || true)
        case $stop_result in
            clean)
                note "VM supervisor and guest stopped cleanly."
                return 0
                ;;
            fallback) die "VM stopped only after Lume's destructive fallback; inspect logs and repair guest shutdown access" ;;
            *) die "VM supervisor exited without recording a completed shutdown" ;;
        esac
    fi
    [ -x "$GREMVM_LUME_BIN" ] || {
        note "VM supervisor is already stopped."
        return 0
    }
    if vm_exists && [ "$(vm_field status 2> /dev/null || true)" = running ]; then
        die "VM is running outside the GremVM supervisor; refusing an ambiguous stop (do not use raw 'lume run')"
    fi
    note "VM supervisor is already stopped."
}

restart_command() {
    stop_command
    start_command
}

status_command() {
    load_release
    load_config
    if [ ! -x "$GREMVM_LUME_BIN" ]; then
        note "state: not-installed"
        return 0
    fi
    deployment_state=$(provision_state)
    case $deployment_state in
        absent) state=not-provisioned ;;
        foreign-vm) state=unmanaged-vm ;;
        creating | created | sip-disabled) state=provisioning-$deployment_state ;;
        managed-vm-missing) state=degraded-missing-vm ;;
        ready) state= ;;
        *) die "unhandled provision state: $deployment_state" ;;
    esac
    if [ -n "$state" ]; then
        note "state: $state"
        note "lume: $LUME_VERSION"
        return 0
    fi

    vm_status=$(vm_field status 2> /dev/null || printf unknown)
    if service_loaded; then
        case $vm_status in
            running) state=running ;;
            stopped) state=starting ;;
            *) state=degraded ;;
        esac
    else
        case $vm_status in
            running) state=unmanaged-running ;;
            stopped) state=stopped ;;
            *) state=degraded ;;
        esac
    fi
    note "state: $state"
    note "vm: $GREMVM_VM_NAME"
    note "lume: $LUME_VERSION"
    note "storage: $GREMVM_VM_STORAGE"
    if [ "$GREMVM_REQUIRE_APPLICATION_FIREWALL" = false ]; then
        note "firewall: enforcement-explicitly-disabled"
    elif firewall_ok; then
        note "firewall: enabled-and-lume-blocked"
    else
        note "firewall: unsafe-or-unverified"
    fi
    ip=$(vm_field ipAddress 2> /dev/null || true)
    [ -z "$ip" ] || note "guest-ip: $ip"
    if [ -e "$GREMVM_STATE_DIR/NEEDS-GUEST-HARDENING" ]; then
        note "security: change the default guest password before remote use"
    fi
}

logs_command() {
    load_config
    lines=200
    follow=false
    while [ "$#" -gt 0 ]; do
        case $1 in
            --follow | -f) follow=true ;;
            --lines)
                shift
                [ "$#" -gt 0 ] || die "--lines requires a number"
                lines=$1
                ;;
            *) die "unknown logs option: $1" ;;
        esac
        shift
    done
    case $lines in
        '' | *[!0-9]*) die "--lines must be a non-negative integer" ;;
    esac
    [ -e "$GREMVM_LOG_DIR/vm.log" ] || die "no logs yet; run '$PROGRAM install'"
    if [ "$follow" = true ]; then
        /usr/bin/tail -n "$lines" -F "$GREMVM_LOG_DIR/vm.log" "$GREMVM_LOG_DIR/vm.error.log"
    else
        /usr/bin/tail -n "$lines" "$GREMVM_LOG_DIR/vm.log" "$GREMVM_LOG_DIR/vm.error.log"
    fi
}

runtime_path_command() {
    load_config
    [ -x "$GREMVM_LUME_BIN" ] || die "Lume is not installed; run '$PROGRAM install'"
    printf '%s\n' "$GREMVM_LUME_BIN"
}

acknowledge_hardening_command() {
    load_config
    [ "${1:-}" = --confirm ] && [ "$#" -eq 1 ] || die "usage: $PROGRAM acknowledge-hardening --confirm"
    [ "$(provision_state)" = ready ] || die "VM provisioning is not complete"
    /bin/rm -f "$GREMVM_STATE_DIR/NEEDS-GUEST-HARDENING"
    note "Guest hardening acknowledgement recorded."
}

console_command() {
    load_config
    if ! service_loaded; then
        start_command
    fi
    elapsed=0
    while [ "$elapsed" -lt 120 ]; do
        url=$(vm_field vncUrl 2> /dev/null || true)
        if [ -n "$url" ]; then
            /usr/bin/open -n -a 'Screen Sharing' "$url"
            return 0
        fi
        sleep 3
        elapsed=$((elapsed + 3))
    done
    die "the VM console did not become available; inspect '$PROGRAM logs'"
}

sip_off_command() {
    load_release
    load_config
    require_command vncdo
    [ "$(provision_state)" = ready ] || die "SIP changes are allowed only for the managed, fully provisioned VM"
    firewall_ok || die "Lume's inbound firewall block is missing; rerun '$PROGRAM install'"
    restart_after=false
    if service_loaded; then
        restart_after=true
        stop_command
    fi
    note "Enter the current '$GREMVM_GUEST_ADMIN_USER' guest password. Lume accepts it on stdin, not in process arguments."
    if ! lume sip off "$GREMVM_VM_NAME" \
        --yes \
        --admin-user "$GREMVM_GUEST_ADMIN_USER" \
        --admin-password-stdin \
        --storage "$GREMVM_VM_STORAGE"; then
        if [ "$restart_after" = true ]; then
            start_command
        fi
        die "Lume did not complete the SIP-disable workflow"
    fi
    if [ "$restart_after" = true ]; then
        start_command
    fi
}

same_device() {
    [ "$(/usr/bin/stat -f %d "$1")" = "$(/usr/bin/stat -f %d "$2")" ]
}

acquire_maintenance_lock() {
    lock_dir=$GREMVM_STATE_DIR/maintenance.lock
    process_started=$(process_identity $$) || die "could not determine the lifecycle process identity"
    case $process_started in
        '' | *[!0-9]*) die "could not determine the lifecycle process identity" ;;
    esac
    mkdir -p "$GREMVM_STATE_DIR"
    if ! mkdir "$lock_dir" 2> /dev/null; then
        maintenance_active && die "another lifecycle or backup operation is active: $lock_dir"
        mkdir "$lock_dir" 2> /dev/null || die "another lifecycle operation acquired the lock: $lock_dir"
    fi
    lock_owner=$$:$process_started
    printf '%s\n' "$lock_owner" > "$lock_dir/owner"
}

release_maintenance_lock() {
    [ -n "${lock_dir:-}" ] && [ -n "${lock_owner:-}" ] || return 0
    observed_owner=$(cat "$lock_dir/owner" 2> /dev/null || true)
    if [ "$observed_owner" = "$lock_owner" ]; then
        /bin/rm -f "$lock_dir/owner"
        rmdir "$lock_dir" 2> /dev/null || true
    fi
    lock_dir=
    lock_owner=
}

wait_for_runner_exit() {
    marker=$1
    limit=${2:-45}
    elapsed=0
    while [ "$elapsed" -lt "$limit" ]; do
        if [ -r "$marker" ]; then
            [ "$(/usr/bin/sed -n '1s/ .*//p' "$marker" 2> /dev/null || true)" = exited ]
            return
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 1
}

run_locked() {
    load_config
    acquire_maintenance_lock
    trap release_maintenance_lock EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    "$@"
    trap - EXIT HUP INT TERM
    release_maintenance_lock
}

backup_command() {
    load_release
    load_config
    destination=
    while [ "$#" -gt 0 ]; do
        case $1 in
            --destination)
                shift
                [ "$#" -gt 0 ] || die "--destination requires an absolute path"
                destination=$1
                ;;
            *) die "unknown backup option: $1" ;;
        esac
        shift
    done
    [ -n "$destination" ] || die "usage: $PROGRAM backup --destination /Volumes/EncryptedBackup/lume"
    case $destination in
        /*) ;;
        *) die "backup destination must be an absolute path" ;;
    esac
    [ -d "$destination" ] || die "backup destination must already exist: $destination"
    [ ! -L "$destination" ] || die "backup destination may not be a symbolic link"
    [ -w "$destination" ] || die "backup destination is not writable: $destination"
    destination=$(CDPATH='' cd -- "$destination" && pwd -P)
    live_storage=$(CDPATH='' cd -- "$GREMVM_VM_STORAGE" && pwd -P)
    [ "$destination" != "$live_storage" ] || die "backup destination is the live VM storage"
    same_device "$destination" "$live_storage" && die "backup destination must be on a different mounted volume"
    vm_exists || die "VM '$GREMVM_VM_NAME' is not provisioned"
    [ "$(provision_state)" = ready ] || die "VM '$GREMVM_VM_NAME' has not completed managed provisioning"
    service_loaded || die "backup requires the managed supervisor; run '$PROGRAM start' and wait for state: running"
    [ "$(vm_field status 2> /dev/null || true)" = running ] || die "VM must reach state: running before backup"

    acquire_maintenance_lock
    restart_after=true
    backup_complete=false
    cleanup_running=false
    backup_cleanup() {
        [ "$cleanup_running" = false ] || return 0
        cleanup_running=true
        release_maintenance_lock
        if [ "$restart_after" = true ] && ! service_loaded; then
            (start_command) || note "WARNING: VM restart failed; run '$PROGRAM start' after resolving the reported error." >&2
        fi
        if [ "$backup_complete" != true ]; then
            note "Backup did not complete; existing VM data and prior backups were preserved." >&2
        fi
    }
    trap backup_cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    runner_exit=$GREMVM_STATE_DIR/last-runner-exit
    /bin/rm -f "$runner_exit"
    request_guest_shutdown || die "guest-clean shutdown could not be confirmed; refusing to back up"
    terminate_managed_runner || die "could not identify and reap the exact managed Lume runner; refusing to back up"
    wait_for_runner_exit "$runner_exit" 45 || die "managed Lume runner did not exit after confirmed guest shutdown; refusing to back up"
    launchctl bootout --wait "$(service_target)" || die "could not unload the stopped VM supervisor"
    wait_for_lume_stopped 20 || die "Lume did not release the stopped VM; refusing to back up"
    [ -d "$destination" ] || die "backup destination disappeared before clone"
    same_device "$destination" "$live_storage" && die "backup destination moved to the live VM filesystem"

    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    backup_name=$GREMVM_VM_NAME--$timestamp
    lume clone "$GREMVM_VM_NAME" "$backup_name" \
        --source-storage "$GREMVM_VM_STORAGE" \
        --dest-storage "$destination"
    [ -d "$destination" ] || die "backup destination disappeared during clone"
    same_device "$destination" "$live_storage" && die "backup destination moved to the live VM filesystem during clone"
    lume get "$backup_name" --storage "$destination" --format json > /dev/null
    for required in disk.img nvram.bin config.json; do
        [ -f "$destination/$backup_name/$required" ] || die "backup verification failed: missing $required"
    done
    umask 077
    manifest=$destination/$backup_name/gremvm-backup.json
    manifest_tmp=$destination/$backup_name/.gremvm-backup.$$
    {
        printf '{\n'
        printf '  "formatVersion": 1,\n'
        printf '  "sourceVM": "%s",\n' "$GREMVM_VM_NAME"
        printf '  "backupVM": "%s",\n' "$backup_name"
        printf '  "createdAt": "%s",\n' "$timestamp"
        printf '  "lumeVersion": "%s",\n' "$LUME_VERSION"
        printf '  "sipExpected": "disabled",\n'
        printf '  "verification": "lume-get-and-required-files"\n'
        printf '}\n'
    } > "$manifest_tmp"
    /bin/mv "$manifest_tmp" "$manifest"

    backup_complete=true
    release_maintenance_lock
    start_command
    restart_after=false
    trap - EXIT HUP INT TERM
    release_maintenance_lock
    note "Backup created: $destination/$backup_name"
    note "backup-path: $destination/$backup_name"
    note "For encrypted, deduplicated off-site history, back up this stopped clone with restic as documented in docs/BACKUPS.md."
}

paths_overlap() {
    first=$1
    second=$2
    [ "$first" = "$second" ] && return 0
    case "$first/" in
        "$second/"*) return 0 ;;
    esac
    case "$second/" in
        "$first/"*) return 0 ;;
    esac
    return 1
}

uninstall_preserves_vm() {
    vm_dir=$GREMVM_VM_STORAGE/$GREMVM_VM_NAME
    if [ -e "$vm_dir" ]; then
        [ -d "$vm_dir" ] || die "VM path is not a directory: $vm_dir"
        [ ! -L "$vm_dir" ] || die "VM directory may not be a symbolic link: $vm_dir"
        vm_dir=$(CDPATH='' cd -- "$vm_dir" && pwd -P)
    fi
    for removal in "$GREMVM_ROOT/runtime" "$GREMVM_ROOT/bin" "$GREMVM_ROOT/versions"; do
        if [ -d "$removal" ]; then
            removal=$(CDPATH='' cd -- "$removal" && pwd -P)
        fi
        paths_overlap "$vm_dir" "$removal" &&
            die "refusing to uninstall because runtime removal overlaps VM data: $vm_dir"
    done
}

uninstall_command() {
    load_config
    uninstall_preserves_vm
    if service_loaded; then
        stop_command
    elif [ -x "$GREMVM_LUME_BIN" ]; then
        stop_command
    fi
    if [ -e "$GREMVM_LAUNCH_AGENT" ]; then
        /bin/rm -f "$GREMVM_LAUNCH_AGENT"
    fi
    if [ -L "$HOME/.local/bin/gremvm" ] && [ "$(readlink "$HOME/.local/bin/gremvm")" = "$GREMVM_ROOT/bin/gremvm" ]; then
        /bin/rm -f "$HOME/.local/bin/gremvm"
    fi
    for removal in "${GREMVM_ROOT:?}/runtime" "${GREMVM_ROOT:?}/bin" "${GREMVM_ROOT:?}/versions"; do
        if [ -e "$removal" ] || [ -L "$removal" ]; then
            /bin/rm -R "$removal"
        fi
    done
    note "Uninstalled the launch agent and deployment runtime."
    note "Preserved VM data, configuration, shutdown keys, logs, and all external backups under $GREMVM_ROOT and $GREMVM_VM_STORAGE."
}

internal_supervise() {
    load_release
    load_config
    firewall_ok || die "Lume's inbound firewall block is missing; refusing to start the VM"
    ! maintenance_active || die "a backup or lifecycle maintenance operation is active"
    state=$(provision_state)
    if [ "$state" != ready ]; then
        /bin/rm -f "$GREMVM_STATE_DIR/READY"
        die "VM is not ready for managed start (provision-state: $state)"
    fi
    umask 077
    mkdir -p "$GREMVM_STATE_DIR" "$GREMVM_LOG_DIR"
    child_pid=
    child_owner=
    stopping=false
    # shellcheck disable=SC2329 # Called asynchronously by the signal trap below.
    supervisor_stop() {
        [ "$stopping" = false ] || return 0
        stopping=true
        trap - HUP INT TERM
        if request_guest_shutdown; then
            stop_result=clean
            if [ -n "$child_pid" ] && kill -0 "$child_pid" 2> /dev/null; then
                kill -TERM "$child_pid" 2> /dev/null || true
            fi
        else
            stop_result=fallback
            note "WARNING: clean guest shutdown could not be confirmed; falling back to Lume stop." >&2
            if ! stop_lume_runner; then
                note "ERROR: Lume runner did not stop after fallback." >&2
            fi
        fi
        if [ -n "$child_pid" ]; then
            wait "$child_pid" 2> /dev/null || true
        fi
        [ -z "$child_owner" ] || clear_runner_owner "$child_owner"
        printf '%s %s\n' "$stop_result" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$GREMVM_STATE_DIR/last-stop"
        exit 0
    }
    trap supervisor_stop HUP INT TERM
    LUME_LOG_LEVEL=error LUME_TELEMETRY_ENABLED=false "$GREMVM_LUME_BIN" run "$GREMVM_VM_NAME" --no-display --network nat --storage "$GREMVM_VM_STORAGE" &
    child_pid=$!
    child_owner=$(write_runner_owner "$child_pid") || {
        stop_lume_runner > /dev/null 2>&1 || true
        wait "$child_pid" 2> /dev/null || true
        die "could not record the managed Lume runner identity"
    }
    set +e
    wait "$child_pid"
    status=$?
    set -e
    child_pid=
    clear_runner_owner "$child_owner"
    child_owner=
    [ "$stopping" = true ] && exit 0
    printf 'exited %s status=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$status" > "$GREMVM_STATE_DIR/last-runner-exit"
    exit "$status"
}

usage() {
    cat << EOF
Usage: $PROGRAM COMMAND

Commands:
  install                         Install pinned Lume and login-time launchd wiring
  provision                       Create the VM, disable SIP, and verify shutdown access
  status                          Show the deployment lifecycle state
  start | stop | restart          Control the VM supervisor
  console                         Open the local VM console
  sip-off                         Re-run Lume's Recovery SIP-disable workflow
  firewall-check                  Verify the required deny-inbound Lume rule
  runtime-path                    Print the pinned Lume executable path
  acknowledge-hardening --confirm
                                  Clear the post-provision security reminder
  logs [--follow] [--lines N]     Read supervisor logs
  backup --destination PATH       Create a stopped clone on another mounted volume
  uninstall                       Remove code and launchd wiring; preserve all data
EOF
}

command=${1:-help}
[ "$#" -eq 0 ] || shift
case $command in
    install) run_locked install_command "$@" ;;
    provision) run_locked provision_command "$@" ;;
    status) status_command "$@" ;;
    start) run_locked start_command "$@" ;;
    stop) run_locked stop_command "$@" ;;
    restart) run_locked restart_command "$@" ;;
    console) run_locked console_command "$@" ;;
    sip-off) run_locked sip_off_command "$@" ;;
    firewall-check) firewall_check_command "$@" ;;
    runtime-path) runtime_path_command "$@" ;;
    acknowledge-hardening) run_locked acknowledge_hardening_command "$@" ;;
    logs) logs_command "$@" ;;
    backup) backup_command "$@" ;;
    uninstall) run_locked uninstall_command "$@" ;;
    internal-supervise) internal_supervise "$@" ;;
    help | --help | -h) usage ;;
    *)
        usage >&2
        die "unknown command: $command"
        ;;
esac
