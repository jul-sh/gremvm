#!/usr/bin/expect -f
set timeout 120
log_user 0

set mode [lindex $argv 0]
set user [lindex $argv 1]
set password [read -nonewline stdin]

switch $mode {
    add {
        spawn /usr/bin/sudo /usr/sbin/sysadminctl \
            -adminUser admin -adminPassword admin \
            -addUser $user -fullName $user -password - -admin
    }
    reset {
        spawn /usr/bin/sudo /usr/sbin/sysadminctl \
            -adminUser admin -adminPassword admin \
            -resetPasswordFor $user -newPassword -
    }
    keychain {
        spawn /usr/bin/security set-keychain-password \
            /Users/admin/Library/Keychains/login.keychain-db
    }
    autologin {
        spawn /usr/bin/sudo /usr/sbin/sysadminctl \
            -autologin set -userName $user -password -
    }
    default {
        exit 64
    }
}

expect {
    -nocase -re {old password: *$} {
        send -- "admin\r"
        exp_continue
    }
    -nocase -re {((user|new|retype new) password|enter password for .*): *$} {
        send -- "$password\r"
        exp_continue
    }
    eof {}
    timeout { exit 124 }
}
catch wait result
exit [lindex $result 3]
